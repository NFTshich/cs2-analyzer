# Режим сбора данных: mock — синтетическая заглушка (запускается без сети),
# sync — импорт реальных матчей с открытого API Liquipedia (без ключей).
CS2_SCRAPER_MODE=sync

# Число синтетических матчей для заглушки.
CS2_SYNTHETIC_MATCHES=1200

# Задержка между запросами к Liquipedia/HLTV (в сотых долях секунды; 250 = 2.5 c).
CS2_REQUEST_DELAY=250

# Лимит страниц турниров при авто-обходе категорий (Liquipedia).
CS2_LIQUIPEDIA_MAX_PAGES=40

# Автообновление данных в фоне (пока приложение запущено):
#   1 - включено (раз в час докачивает новые матчи и переобучает модель)
#   0 - выключено
CS2_AUTO_REFRESH=1
# Период автообновления в секундах (3600 = 1 час).
CS2_AUTO_REFRESH_INTERVAL=3600

# Пути к файлам данных/модели (относительно корня проекта).
# CS2_MATCHES_RAW=data/raw/matches.csv
# CS2_MATCHES_PROCESSED=data/processed/features.parquet
# CS2_MODEL_PATH=models/model.pkl
# CS2_MODEL_META=models/model_meta.json

# Прокси/HTTP-настройки для режима sync (при необходимости).
# HTTP_PROXY=
# HTTPS_PROXY=